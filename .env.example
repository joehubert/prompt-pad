# Fill in only the providers you want to use, then rename this file to .env.
# You don't need every key below - the app greys out any provider without one.

# console.groq.com -> API Keys
GROQ_API_KEY=

# openrouter.ai -> Keys
OPENROUTER_API_KEY=

# dash.cloudflare.com -> AI > Workers AI (token), Account ID in right sidebar
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# github.com/settings/tokens -> fine-grained token with models:read
GITHUB_TOKEN=

# build.nvidia.com -> Get API Key on any model card
NVIDIA_API_KEY=

# console.mistral.ai -> API Keys (phone verification required)
MISTRAL_API_KEY=

# dashboard.cohere.com -> API Keys (trial key is free)
COHERE_API_KEY=

### Other app settings
TEMPERATURE=0.4
MAX_TOKENS=1024
SYSTEM_PROMPT=You are a helpful assistant.
